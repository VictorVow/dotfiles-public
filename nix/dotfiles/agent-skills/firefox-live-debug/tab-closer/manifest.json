{
  "manifest_version": 2,
  "name": "0-Custom - Tab Closer",
  "version": "0.0.2",
  "description": "Lets a local CLI list/close tabs by URL via native messaging.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ff-tab-closer@example.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
