# Linted by `just check` / the pre-commit hook.
skip_list:
  - name[casing]      # task names are written "Tool | step", not capitalised
  - name[play]
  - complexity[play]  # custom-installers.yml is one big play by design
  - fqcn[action-core]

# Real findings, kept visible but non-fatal until they're fixed.
warn_list:
  - no-changed-when
  - no-handler
  - risky-shell-pipe
  - command-instead-of-module
