# Machine-local agent state stays in .git/info/exclude (written by the
# claude-md-ignored / direnv-ignored skills). This file is for patterns that
# should apply to every clone.

# 0SHORTCUTS is a live launcher folder that apps write into — keep runtime and
# personal data out of git.
0SHORTCUTS/**/*.db/
0SHORTCUTS/**/*.csv

# Editor backups
*~
*.swp

# Python bytecode
__pycache__/

# nix build output symlink
/result

# Hermes runtime lock files that the agent drops next to tracked memory/skill
# files (the tracked dirs themselves are symlinked into the live ~/.hermes).
/nix/dotfiles/hermes/**/*.lock

# web-ext signing upload-tracking file
.amo-upload-uuid
